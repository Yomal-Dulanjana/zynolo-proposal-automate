# Environment Configuration Template — Proposal Automation Platform
# Copy this file to .env or configure in the Vercel Project Dashboard (Settings > Environment Variables)

# ─── Production Database Connection ──────────────────────────────────────────
# TiDB Serverless, Supabase, Neon, AWS RDS, or standard MySQL/PostgreSQL
DATABASE_URL="mysql://user:password@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/proposal_automation?sslaccept=strict"

# ─── System Configuration Defaults ───────────────────────────────────────────
DEFAULT_COGS_PER_HEAD=80.00
CORPORATE_GP_PERCENTAGE=0.60

# ─── Authentication & Admin Session Secrets ──────────────────────────────────
JWT_SECRET="your-strong-random-jwt-secret-key-change-this"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="pa_session"

# HOD Executive Admin Authentication (Decoupled Runtime)
ADMIN_JWT_SECRET="your-strong-random-admin-secret-key-change-this"
HOD_ADMIN_EMAIL="admin@dtech.lk"
HOD_ADMIN_PASSWORD="Sales@dtechlk19940"

# ─── Application Branding & Details ───────────────────────────────────────────
PUBLIC_APP_NAME="Zynolo People Proposal Automation"
PUBLIC_COMPANY_NAME="Zynolo People"

# ─── SMTP Relay Configuration (Brevo / SendGrid / Postmark / Generic) ─────────
MAIL_FROM="Zynolo People Proposal <noreply@example.com>"
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="Zynolo People Proposal"
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_SECURE=false
SMTP_ENCRYPTION="tls"
SMTP_AUTH=true
SMTP_ALLOW_SELF_SIGNED=false

# ─── File Storage (Local fallback or S3/Blob) ─────────────────────────────────
UPLOAD_DIR="./public/uploads"
PDF_DIR="./public/pdfs"
MAX_FILE_SIZE="5242880"
