---
// src/layouts/AppLayout.astro — Authenticated app shell with sidebar
import "../styles/global.css";
import type { JWTPayload } from "../lib/auth";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title?: string;
  user: JWTPayload;
  activePage?: string;
}

const { title = "Dashboard", user, activePage = "dashboard" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — D-Tech Zynolo People Proposal Automation</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 min-h-screen">
    <div class="flex h-screen overflow-hidden">
      <!-- ── Sidebar ──────────────────────────────────────────────── -->
      <Sidebar user={user} activePage={activePage} />

      <!-- ── Main content ──────────────────────────────────────────── -->
      <main class="flex-1 overflow-y-auto">
        <!-- Top bar -->
        <header class="bg-white border-b border-slate-200 px-8 py-4 flex items-center justify-between sticky top-0 z-10">
          <h1 class="font-heading font-semibold text-xl text-slate-900 tracking-tight">{title}</h1>
          <div class="flex items-center gap-3">
            <a
              href="/proposals/new"
              class="btn-primary text-sm py-2 px-4 font-heading font-medium"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
              New Proposal
            </a>
          </div>
        </header>

        <div class="p-8">
          <slot />
        </div>
      </main>
    </div>

    <script>
      document.getElementById("logout-btn")?.addEventListener("click", async () => {
        const res = await fetch("/api/auth/logout", { method: "POST" });
        if (res.ok) window.location.href = "/login";
      });
    </script>
  </body>
</html>
