---
// src/layouts/AdminLayout.astro — Executive HOD App Shell with Dark Slate/Navy Sidebar
import "../styles/global.css";
import type { AdminJWTPayload } from "../lib/adminAuth.js";
import AdminSidebar from "../components/admin/AdminSidebar.astro";

interface Props {
  title?: string;
  adminUser: AdminJWTPayload;
  activePage?: "overview" | "dashboard" | "waiting-proposals" | "proposals" | "pipeline" | "expiring" | "team" | "clients" | "analytics";
}

const { title = "Executive Oversight", adminUser, activePage = "dashboard" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Zynolo People HOD Executive Portal</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 min-h-screen text-slate-900 selection:bg-red-600 selection:text-white">
    <div class="flex h-screen overflow-hidden">
      
      <!-- ── Executive Dark Sidebar ───────────────────────────────────── -->
      <AdminSidebar adminUser={adminUser} activePage={activePage} />

      <!-- ── Main Content Area ────────────────────────────────────────── -->
      <main class="flex-1 overflow-y-auto flex flex-col min-w-0">
        <!-- Top Executive Header Bar -->
        <header class="bg-white border-b border-slate-200 px-8 py-4 flex items-center justify-between sticky top-0 z-20 flex-shrink-0 shadow-2xs">
          <div class="flex items-center gap-3">
            <h1 class="font-heading font-semibold text-xl text-slate-900 tracking-tight">{title}</h1>
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-heading font-semibold uppercase tracking-wider bg-red-50 text-red-700 border border-red-200">
              Executive Level
            </span>
          </div>

          <div class="flex items-center gap-3">
            <div class="hidden sm:flex items-center gap-2 text-xs font-semibold text-slate-500 bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>{adminUser.email}</span>
            </div>
          </div>
        </header>

        <!-- Main Page View Slot -->
        <div class="w-full max-w-none px-6 lg:px-8 py-6 flex-1">
          <slot />
        </div>
      </main>

    </div>
  </body>
</html>
