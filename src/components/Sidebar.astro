---
// src/components/Sidebar.astro — Corporate Deep Navy/Slate Sidebar with dynamic counter badges
import { prisma } from "../lib/prisma.js";
import type { JWTPayload } from "../lib/auth";

interface Props {
  user: JWTPayload;
  activePage?: string;
}

const { user, activePage = "dashboard" } = Astro.props;

// Compute real-time counter badges directly via Prisma in SSR
const proposals = await prisma.proposal.findMany({
  where: { salesUserId: user.userId },
  select: { status: true, expiryDate: true },
});

const clientsCount = await prisma.clientProfile.count({
  where: { salesUserId: user.userId },
});

const now = new Date();
const in5Days = new Date(now.getTime() + 5 * 24 * 60 * 60 * 1000);

const totalProposalsCount = proposals.length;
const activePipelineCount = proposals.filter((p) =>
  ["SENT", "VIEWED", "IN_NEGOTIATION", "APPROVED"].includes(p.status)
).length;

const expiringSoonCount = proposals.filter((p) => {
  if (["ACCEPTED", "REJECTED", "EXPIRED"].includes(p.status)) return false;
  const exp = new Date(p.expiryDate);
  return exp >= now && exp <= in5Days;
}).length;
---

<aside class="w-64 bg-slate-900 flex flex-col flex-shrink-0 h-full overflow-y-auto border-r border-slate-800">
  <!-- Brand Header -->
  <div class="px-6 py-5 border-b border-slate-800 flex items-center justify-between">
    <div>
      <div class="text-white font-heading font-semibold text-xl tracking-tight flex items-center gap-1.5">
        <span class="w-3 h-3 rounded-full bg-red-600 inline-block"></span>
        <span>Zynolo<span class="text-red-600"> People</span></span>
      </div>
      <div class="text-slate-400 text-[10px] mt-0.5 font-heading font-medium uppercase tracking-wider">
        Proposal Automation Portal
      </div>
    </div>
  </div>

  <!-- Navigation Menu -->
  <nav class="flex-1 px-3 py-5 space-y-1">
    <p class="text-slate-500 text-[10px] font-heading font-semibold uppercase tracking-widest px-3 mb-2">
      Core Operations
    </p>

    <!-- Dashboard -->
    <a
      href="/dashboard"
      class={`sidebar-link flex items-center justify-between ${activePage === "dashboard" ? "active" : ""}`}
    >
      <div class="flex items-center gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        <span>Dashboard</span>
      </div>
    </a>

    <!-- New Proposal -->
    <a
      href="/proposals/new"
      class={`sidebar-link flex items-center justify-between ${activePage === "new-proposal" ? "active" : ""}`}
    >
      <div class="flex items-center gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        <span>New Proposal</span>
      </div>
      <span class="text-[10px] uppercase font-bold text-red-400 bg-red-950/60 border border-red-800/40 px-1.5 py-0.5 rounded">
        Fast
      </span>
    </a>

    <!-- All Proposals with total counter badge -->
    <a
      href="/proposals"
      class={`sidebar-link flex items-center justify-between ${activePage === "proposals" ? "active" : ""}`}
    >
      <div class="flex items-center gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>All Proposals</span>
      </div>
      {totalProposalsCount > 0 && (
        <span class="bg-red-600 text-white text-xs px-2 py-0.5 rounded-full font-semibold shadow-xs">
          {totalProposalsCount}
        </span>
      )}
    </a>

    <!-- Pipeline / Deals with active deals badge -->
    <a
      href="/pipeline"
      class={`sidebar-link flex items-center justify-between ${activePage === "pipeline" ? "active" : ""}`}
    >
      <div class="flex items-center gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/></svg>
        <span>Pipeline / Deals</span>
      </div>
      {activePipelineCount > 0 && (
        <span class="bg-blue-600 text-white text-xs px-2 py-0.5 rounded-full font-semibold shadow-xs">
          {activePipelineCount}
        </span>
      )}
    </a>

    <!-- Expiring Soon Warning Badge -->
    <a
      href="/proposals?filter=expiring"
      class={`sidebar-link flex items-center justify-between ${activePage === "expiring" ? "active" : ""}`}
    >
      <div class="flex items-center gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span>Expiring Soon</span>
      </div>
      {expiringSoonCount > 0 && (
        <span class="bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs px-2 py-0.5 rounded-full font-semibold">
          {expiringSoonCount}
        </span>
      )}
    </a>

    <!-- Management & Accounts Header -->
    <p class="text-slate-500 text-[10px] font-heading font-semibold uppercase tracking-widest px-3 pt-4 mb-2">
      Management
    </p>

    <!-- Clients & Accounts -->
    <a
      href="/clients"
      class={`sidebar-link flex items-center justify-between ${activePage === "clients" ? "active" : ""}`}
    >
      <div class="flex items-center gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        <span>Client Accounts</span>
      </div>
      {clientsCount > 0 && (
        <span class="bg-slate-800 text-slate-300 text-xs px-2 py-0.5 rounded-full font-semibold border border-slate-700">
          {clientsCount}
        </span>
      )}
    </a>

    <!-- Reports & Analytics -->
    <a
      href="/analytics"
      class={`sidebar-link flex items-center justify-between ${activePage === "analytics" ? "active" : ""}`}
    >
      <div class="flex items-center gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        <span>Sales Analytics</span>
      </div>
    </a>
  </nav>

  <!-- User Profile & Session Controls -->
  <div class="border-t border-slate-800 p-4 bg-slate-950/40">
    <div class="flex items-center gap-3 mb-3">
      <div class="w-9 h-9 bg-red-600 rounded-xl flex items-center justify-center text-white font-bold text-sm flex-shrink-0 shadow-sm shadow-red-600/30">
        {(user?.fullName || "User").charAt(0).toUpperCase()}
      </div>
      <div class="min-w-0">
        <div class="text-white text-sm font-heading font-semibold truncate">{user?.fullName || "Representative"}</div>
        <div class="text-slate-500 text-xs truncate">{user?.email || "sales@dtech.lk"}</div>
      </div>
    </div>
    <div class="space-y-1">
      <a
        href="/profile"
        class={`sidebar-link text-xs flex items-center gap-2 ${activePage === "profile" ? "active" : ""}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        <span>Profile Settings</span>
      </a>
      <button
        id="logout-btn"
        class="sidebar-link w-full text-xs text-rose-400 hover:text-rose-300 hover:bg-rose-950/30 flex items-center gap-2 cursor-pointer transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        <span>Logout</span>
      </button>
    </div>
  </div>
</aside>
