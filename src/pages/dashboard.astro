---
// src/pages/dashboard.astro — Sales rep dashboard overview
import AppLayout from "../layouts/AppLayout.astro";
import ProposalDashboard from "../components/ProposalDashboard";

const user = Astro.locals.user!;
---

<AppLayout title="Dashboard" user={user} activePage="dashboard">
  <!-- Welcome banner -->
  <div class="mb-8 bg-gradient-to-r from-slate-900 to-slate-800 rounded-2xl p-7 text-white relative overflow-hidden">
    <div class="absolute right-0 top-0 bottom-0 w-64 opacity-10"
      style="background: radial-gradient(circle at right, #dc2626 0%, transparent 70%)">
    </div>
    <div class="relative z-10">
      <div class="text-sm text-slate-400 mb-1">Good {new Date().getHours() < 12 ? 'morning' : new Date().getHours() < 18 ? 'afternoon' : 'evening'},</div>
      <h2 class="font-heading font-semibold text-2xl text-white">{user.fullName} 👋</h2>
      <p class="text-slate-400 text-sm mt-1">Manage and track all your client proposals from here.</p>
      <div class="mt-4 flex gap-3">
        <a href="/proposals/new" class="btn-primary text-sm py-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          New Proposal
        </a>
        <a href="/proposals" class="btn-secondary text-sm py-2 bg-white/10 border-white/20 text-white hover:bg-white/20">
          View All
        </a>
      </div>
    </div>
  </div>

  <!-- Proposal table with built-in stats -->
  <ProposalDashboard client:load />
</AppLayout>
