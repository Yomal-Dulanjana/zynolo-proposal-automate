---
// src/pages/admin/expiring.astro — Executive Urgent Expiry Oversight
import AdminLayout from "../../layouts/AdminLayout.astro";
import { prisma } from "../../lib/prisma.js";
import ExpiringProposalsView, { type ExpiringProposalItem } from "../../components/admin/ExpiringProposalsView";

// Ensure admin user is authenticated
const adminUser = Astro.locals.adminUser;
if (!adminUser || adminUser.role !== "HOD_ADMIN") {
  return Astro.redirect("/login");
}

const now = new Date();
const in5Days = new Date(now.getTime() + 5 * 24 * 60 * 60 * 1000);

// Fetch all proposals expiring within 5 days across all reps
const rawProposals = await prisma.proposal.findMany({
  where: {
    status: { notIn: ["ACCEPTED", "REJECTED", "EXPIRED"] },
    expiryDate: { lte: in5Days },
  },
  include: {
    salesUser: {
      select: {
        id: true,
        fullName: true,
        email: true,
        mobileNumber: true,
      },
    },
  },
  orderBy: { expiryDate: "asc" },
});

const proposals: ExpiringProposalItem[] = rawProposals.map((p) => {
  const expDate = new Date(p.expiryDate);
  const diffTime = expDate.getTime() - now.getTime();
  const daysRemaining = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

  return {
    id: p.id,
    proposalId: p.proposalId,
    clientName: p.clientName,
    clientEmail: p.clientEmail,
    clientPhone: p.clientPhone,
    salesRepName: p.salesUser?.fullName || "Unassigned Rep",
    salesRepEmail: p.salesUser?.email || "-",
    salesRepPhone: p.salesUser?.mobileNumber,
    baseAmount: Number(p.baseAmount || 0),
    vatAmount: Number(p.vatAmount || 0),
    totalAmount: Number(p.totalAmount || 0),
    status: p.status,
    proposalDate: new Date(p.proposalDate).toISOString(),
    expiryDate: expDate.toISOString(),
    daysRemaining,
  };
});
---

<AdminLayout title="Expiring Soon Proposals" adminUser={adminUser} activePage="expiring">
  <div class="w-full max-w-none space-y-6">
    <ExpiringProposalsView client:load initialProposals={proposals} />
  </div>
</AdminLayout>
