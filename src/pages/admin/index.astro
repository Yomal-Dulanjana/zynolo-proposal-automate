---
// src/pages/admin/index.astro — Executive HOD Proposal Oversight Dashboard (SSR)
import AdminLayout from "../../layouts/AdminLayout.astro";
import { prisma } from "../../lib/prisma.js";
import AdminDashboard from "../../components/admin/AdminDashboard";
import {
  ACTIVE_PIPELINE_STATUSES,
  TERMINAL_WON_STATUSES,
  TERMINAL_LOST_STATUSES,
  TERMINAL_EXPIRED_STATUSES,
  HOD_REVIEW_STATUSES,
  buildPipelineTrendData,
  computeConversionRatio,
  isInternalOrUnapprovedProposal,
  computeAggregatedFinancials,
  CORPORATE_GP_PERCENTAGE,
} from "../../utils/financialAnalytics.js";
import type {
  AdminDashboardData,
  AdminProposalItem,
  RepPerformanceMetric,
  DepartmentMetrics,
  MonthlyDepartmentTrend,
} from "../../components/admin/types";

// Ensure admin user is authenticated
const adminUser = Astro.locals.adminUser;
if (!adminUser || adminUser.role !== "HOD_ADMIN") {
  return Astro.redirect("/login");
}

// 1. Fetch all registered sales representatives
const salesUsers = await prisma.salesUser.findMany({
  select: {
    id: true,
    fullName: true,
    email: true,
    mobileNumber: true,
  },
  orderBy: { fullName: "asc" },
});

// 2. Fetch all proposals across the entire sales force with rep relations
const rawProposals = await prisma.proposal.findMany({
  include: {
    salesUser: {
      select: {
        id: true,
        fullName: true,
        email: true,
        mobileNumber: true,
      },
    },
  },
  orderBy: { proposalDate: "desc" },
});

// 3. Format Master Proposal items (60% Corporate GP rule)
const cogsPerHead = Number(process.env.DEFAULT_COGS_PER_HEAD || "80.00");

const proposals: AdminProposalItem[] = rawProposals.map((p) => {
  const baseAmt = Number(p.baseAmount || 0);
  const empCount = p.employeeCount || 0;
  const staff = Math.max(1, empCount);
  const totalAmt = Number(p.totalAmount || 0);
  const rate = Number(p.ratePerUser) || 400.0;
  const baseRev = baseAmt > 0 ? baseAmt : staff * rate;
  const cogsRate = Number(p.cogsRateWithVat) || cogsPerHead;
  const totalCogs = Number(p.totalCogsAmount) || (staff * cogsRate);
  
  // Standard 60% Corporate GP Rule
  const gp = Number((baseRev * CORPORATE_GP_PERCENTAGE).toFixed(2));
  const gpPct = 60.0;

  return {
    id: p.id,
    proposalId: p.proposalId,
    salesUserId: p.salesUserId,
    salesRepName: p.salesUser?.fullName || "Unassigned Rep",
    salesRepEmail: p.salesUser?.email || "-",
    clientName: p.clientName,
    clientEmail: p.clientEmail,
    clientPhone: p.clientPhone,
    employeeCount: empCount,
    baseAmount: baseAmt,
    vatAmount: Number(p.vatAmount || 0),
    totalAmount: totalAmt,
    cogsEstimated: cogsRate,
    cogsRateWithVat: cogsRate,
    totalCogsAmount: totalCogs,
    grossProfit: gp,
    grossMarginPct: gpPct,
    lossReason: p.lossReason,
    lossNotes: p.lossNotes,
    rejectionComment: p.rejectionComment,
    rejectedAt: p.rejectedAt ? new Date(p.rejectedAt).toISOString() : null,
    rejectedByRole: p.rejectedByRole,
    lastContactedAt: p.lastContactedAt ? new Date(p.lastContactedAt).toISOString() : null,
    status: p.status as AdminProposalItem["status"],
    stage: p.stage,
    isHodApproved: p.isHodApproved,
    proposalDate: new Date(p.proposalDate).toISOString(),
    expiryDate: new Date(p.expiryDate).toISOString(),
    pdfPath: p.pdfPath,
    hodComment: p.hodComment,
    reviewedAt: p.reviewedAt ? new Date(p.reviewedAt).toISOString() : null,
    reviewedBy: p.reviewedBy,
  };
});

// 4. Compute Standard Department-Wide Accounting Metrics via centralized engine
const financialMetrics = computeAggregatedFinancials(rawProposals);

// Active Pipeline (Approved / Sent & Negotiation only, Excl. VAT, strictly gatekept from HOD_PENDING)
const pipelineProposals = rawProposals.filter((p) => {
  const rawStatus = (p.status || "").toUpperCase();
  const rawStage = (p.stage || "").toUpperCase();
  const isApproved = p.isHodApproved === true || rawStage === "APPROVED_SENT" || rawStatus === "SENT" || rawStatus === "APPROVED";
  
  const isPending =
    !isApproved ||
    rawStatus.includes("PENDING") ||
    rawStatus.includes("HOD") ||
    rawStatus.includes("DRAFT") ||
    rawStatus.includes("CHANGE") ||
    HOD_REVIEW_STATUSES.includes(rawStatus);

  if (isPending) return false;

  const isActive =
    ["APPROVED_SENT", "SENT", "NEGOTIATION", "IN_NEGOTIATION", "IN_DISCUSSION", "PROPOSAL_SENT"].includes(rawStage) ||
    ["APPROVED_SENT", "SENT", "NEGOTIATION", "IN_NEGOTIATION", "IN_DISCUSSION"].includes(rawStatus);

  return (
    isActive &&
    !TERMINAL_WON_STATUSES.includes(rawStatus) &&
    !TERMINAL_LOST_STATUSES.includes(rawStatus) &&
    !TERMINAL_EXPIRED_STATUSES.includes(rawStatus)
  );
});

const activePipelineBase = pipelineProposals.reduce((sum, p) => {
  const staff = Number(p.employeeCount) || 10;
  const rate = Number(p.ratePerUser) || 400.00;
  return sum + (p.baseAmount ? Number(p.baseAmount) : staff * rate);
}, 0);

const totalProposalsDispatched = proposals.length;
const wonCount = financialMetrics.wonDealsCount;
const activeCount = pipelineProposals.length;
const lostCount = proposals.filter((p) => ["REJECTED", "EXPIRED"].includes(p.status)).length;

const totalMarketDeals = wonCount + activeCount + lostCount;
const overallCloseRate = totalMarketDeals > 0 ? Number(((wonCount / totalMarketDeals) * 100).toFixed(1)) : 0.0;

const metrics: DepartmentMetrics = {
  totalRevenueWon: financialMetrics.monthlyBaseRevenue,         // 3,115,390.00
  revenueWonMonthly: financialMetrics.monthlyBaseRevenue,       // 3,115,390.00
  monthlyBaseRevenue: financialMetrics.monthlyBaseRevenue,      // 3,115,390.00
  grossBillingWon: financialMetrics.grossBilling,               // 3,676,160.20
  totalPipelineValue: Number(activePipelineBase.toFixed(2)),    // 3,289,084.00
  activePipeline: Number(activePipelineBase.toFixed(2)),        // 3,289,084.00
  totalProposalsDispatched,                                     // 125
  overallCloseRate,
  wonCount,                                                     // 48
  activeCount,
  lostCount,
  totalGrossProfitWon: financialMetrics.monthlyGrossProfit,     // 1,869,234.00
  monthlyGrossProfit: financialMetrics.monthlyGrossProfit,     // 1,869,234.00
  annualGrossProfit: financialMetrics.annualGrossProfit,       // 22,430,808.00
  averageGrossMargin: financialMetrics.grossMarginPct,          // 60.0
  grossMargin: financialMetrics.grossMarginPercentage,         // "60.0%"
  grossMarginPct: financialMetrics.grossMarginPct,             // 60.0
};

// 5. Compute Sales Team Performance Leaderboard (Consistently Excl. VAT Base & 60% GP)
const leaderboard: RepPerformanceMetric[] = salesUsers
  .map((rep) => {
    const repProps = rawProposals.filter((p) => p.salesUserId === rep.id);
    const repTotal = repProps.length;
    const repWon = repProps.filter((p) =>
      TERMINAL_WON_STATUSES.includes((p.status || "").toUpperCase()) ||
      TERMINAL_WON_STATUSES.includes((p.stage || "").toUpperCase()) ||
      (p.status || "").toUpperCase().includes("WON") ||
      (p.status || "").toUpperCase().includes("ACCEPT")
    );
    const repPipeline = repProps.filter((p) =>
      ACTIVE_PIPELINE_STATUSES.includes((p.status || "").toUpperCase()) &&
      !isInternalOrUnapprovedProposal(p)
    );
    const repLost = repProps.filter((p) =>
      TERMINAL_LOST_STATUSES.includes((p.status || "").toUpperCase()) ||
      TERMINAL_EXPIRED_STATUSES.includes((p.status || "").toUpperCase())
    );

    const wonBaseRevenue = repWon.reduce((sum, p) => {
      const staff = Number(p.employeeCount) || 10;
      const rate = Number(p.ratePerUser) || 400.00;
      return sum + (p.baseAmount ? Number(p.baseAmount) : staff * rate);
    }, 0);

    const pipelineBaseValue = repPipeline.reduce((sum, p) => {
      const staff = Number(p.employeeCount) || 10;
      const rate = Number(p.ratePerUser) || 400.00;
      return sum + (p.baseAmount ? Number(p.baseAmount) : staff * rate);
    }, 0);

    const lostBaseValue = repLost.reduce((sum, p) => {
      const staff = Number(p.employeeCount) || 10;
      const rate = Number(p.ratePerUser) || 400.00;
      return sum + (p.baseAmount ? Number(p.baseAmount) : staff * rate);
    }, 0);

    const repMonthlyGP = Number((wonBaseRevenue * CORPORATE_GP_PERCENTAGE).toFixed(2));
    const repAnnualGP = Number((repMonthlyGP * 12).toFixed(2));

    const repMarketDeals = repWon.length + repPipeline.length + repLost.length;
    const winRate = repMarketDeals > 0 ? Number(((repWon.length / repMarketDeals) * 100).toFixed(1)) : 0.0;

    return {
      repId: rep.id,
      repName: rep.fullName,
      email: rep.email,
      phone: rep.mobileNumber || "",
      totalProposals: repTotal,
      pipelineCount: repPipeline.length,
      pipelineValue: pipelineBaseValue,
      wonCount: repWon.length,
      wonValue: wonBaseRevenue,
      wonBaseRevenue,
      monthlyGrossProfit: repMonthlyGP,
      annualGrossProfit: repAnnualGP,
      lostCount: repLost.length,
      lostValue: lostBaseValue,
      winRate,
    };
  })
  .sort((a, b) => b.wonValue - a.wonValue || b.totalProposals - a.totalProposals);

// 6. Compute 6-Month Department Revenue & Pipeline Trend (Gatekeeps unapproved HOD pending proposals)
const trendData = buildPipelineTrendData(proposals, "monthly");
const monthlyTrend: MonthlyDepartmentTrend[] = trendData.map((t) => ({
  month: t.month,
  proposed: t.proposed,
  won: t.won,
  lost: t.lost,
  count: t.count,
}));

const dashboardData: AdminDashboardData = {
  metrics,
  leaderboard,
  proposals,
  monthlyTrend,
  adminEmail: adminUser.email,
};
---

<AdminLayout
  title="Executive Overview"
  adminUser={adminUser}
  activePage="overview"
>
  <AdminDashboard client:load data={dashboardData} />
</AdminLayout>
